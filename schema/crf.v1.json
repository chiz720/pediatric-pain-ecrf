{
  "schemaVersion": "1.0.0",
  "title": "Prospective Perioperative Pediatric Pain Assessment — eCRF",
  "generated": "2026-09-11",
  "paramsVersion": "1.5.0",
  "provenanceColumns": [
    "submission_uuid", "supersedes_uuid", "study_number", "rater_id", "device_id",
    "client_ts", "server_ts", "schema_version", "app_version", "params_version", "training"
  ],

  "instruments": {
    "flacc": {
      "label": "FLACC",
      "range": [0, 10],
      "source": "Merkel et al., Pediatr Nurs 1997",
      "domains": [
        { "id": "face",         "label": "Face",          "options": ["No particular expression or smile", "Occasional grimace or frown, withdrawn, uninterested", "Frequent to constant frown, quivering chin, clenched jaw"] },
        { "id": "legs",         "label": "Legs",          "options": ["Normal position or relaxed", "Uneasy, restless, tense", "Kicking, or legs drawn up"] },
        { "id": "activity",     "label": "Activity",      "options": ["Lying quietly, normal position, moves easily", "Squirming, shifting back and forth, tense", "Arched, rigid, or jerking"] },
        { "id": "cry",          "label": "Cry",           "options": ["No cry (awake or asleep)", "Moans or whimpers, occasional complaint", "Crying steadily, screams or sobs, frequent complaints"] },
        { "id": "consolability","label": "Consolability", "options": ["Content, relaxed", "Reassured by occasional touching, hugging or talking; distractible", "Difficult to console or comfort"] }
      ]
    },
    "r_flacc": {
      "label": "revised FLACC",
      "range": [0, 10],
      "source": "Malviya et al., Paediatr Anaesth 2006",
      "note": "Same five domains with caregiver-supplied individualised behaviour descriptors, captured at enrolment.",
      "inherits": "flacc"
    },
    "fps_r": {
      "label": "Faces Pain Scale — Revised",
      "range": [0, 10],
      "source": "Hicks et al., Pain 2001",
      "faces": 6,
      "values": [0, 2, 4, 6, 8, 10],
      "anchors": { "low": "no pain", "high": "very much pain" },
      "note": "Sex- and ethnicity-neutral line drawings. No smile at the low anchor, no tears at the high anchor. Record the 0-10 metric value, not the ordinal face position."
    },
    "nrs": {
      "label": "Numerical Rating Scale (11-point)",
      "range": [0, 10],
      "source": "von Baeyer et al., Pain 2009",
      "anchors": { "low": "no pain", "high": "worst pain imaginable" }
    },
    "paed": {
      "label": "Pediatric Anesthesia Emergence Delirium scale",
      "range": [0, 20],
      "source": "Sikich & Lerman, Anesthesiology 2004",
      "responseScale": ["Not at all", "Just a little", "Quite a bit", "Very much", "Extremely"],
      "note": "All five items are recorded on the same not-at-all to extremely response scale (0-4). Items 1-3 are reverse-scored by the app, never by the rater.",
      "items": [
        { "id": "eye_contact", "label": "The child makes eye contact with the caregiver", "reverse": true },
        { "id": "purposeful",  "label": "The child's actions are purposeful",              "reverse": true },
        { "id": "aware",       "label": "The child is aware of their surroundings",        "reverse": true },
        { "id": "restless",    "label": "The child is restless",                           "reverse": false },
        { "id": "inconsolable","label": "The child is inconsolable",                       "reverse": false }
      ]
    },
    "mypas_sf": {
      "label": "modified Yale Preoperative Anxiety Scale — Short Form",
      "range": [22.92, 100],
      "source": "Kain et al. 1997; Jenkins et al., Anesth Analg 2014",
      "note": "Four domains. The Use of Parents domain is omitted in the short form. Score = mean of (item / item maximum) across domains, x100.",
      "domains": [
        { "id": "activity",      "label": "Activity",              "max": 4 },
        { "id": "vocalisation",  "label": "Vocalisation",          "max": 6 },
        { "id": "expressivity",  "label": "Emotional expressivity","max": 4 },
        { "id": "arousal",       "label": "State of apparent arousal", "max": 4 }
      ]
    },
    "umss": {
      "label": "University of Michigan Sedation Scale",
      "range": [0, 4],
      "source": "Malviya et al., Br J Anaesth 2002",
      "options": [
        "Awake and alert",
        "Minimally sedated: tired/sleepy, appropriate response to conversation",
        "Moderately sedated: somnolent/sleeping, easily roused with light tactile stimulation",
        "Deeply sedated: deep sleep, rousable only with significant physical stimulation",
        "Unrousable"
      ]
    }
  },

  "forms": [
    {
      "id": "00_device",
      "title": "Device setup",
      "cardinality": "local",
      "sheet": null,
      "note": "Stored on the tablet only. Never submitted as a record; stamped onto every submission.",
      "sections": [
        { "id": "provision", "title": "Provisioning", "items": [
          { "id": "device_id",      "label": "Device",           "type": "computed", "derive": "device_id", "readOnly": true, "help": "Generated per browser. Collectors use their own phones, so nobody names a device." },
          { "id": "site_code",      "label": "Site code",        "type": "text", "required": true, "pattern": "^[A-Z]{2}$" },
          { "id": "camp_id",        "label": "Camp ID",          "type": "text", "required": true },
          { "id": "endpoint_url",   "label": "Endpoint URL",     "type": "text", "required": true },
          { "id": "device_token",   "label": "Your token",       "type": "secret", "required": true, "help": "Issued to you personally in the _raters tab. Do not share it — rows are attributed to whoever the token belongs to." },
          { "id": "rater_id",       "label": "Your rater ID",    "type": "text", "required": true },
          { "id": "rater_role",     "label": "Role",             "type": "select", "required": true, "options": ["Anaesthetist", "Surgeon", "PACU nurse", "Ward nurse", "Research assistant", "Coordinator"] },
          { "id": "app_pin",        "label": "App PIN",          "type": "secret", "required": true, "help": "Required on launch and after 5 minutes idle. The tablet holds dates of birth." },
          { "id": "calibrated",     "label": "Rater has passed M10 calibration", "type": "boolean", "required": true, "help": "If false the app runs in training mode and tags submissions training=1." }
        ]}
      ]
    },

    {
      "id": "01_enrolment",
      "title": "Enrolment, consent and assent",
      "cardinality": "once",
      "sheet": "01_enrolment",
      "gatekeeper": true,
      "note": "No other module may be opened for a study number until this form is complete.",
      "sections": [
        { "id": "identify", "title": "Identification", "items": [
          { "id": "study_number", "label": "Study number", "type": "study_number", "required": true,
            "pattern": "^PPP-[A-Z]{2}-\\d{4}$",
            "validate": ["unique_against_roster"],
            "help": "Allocated by the endpoint the moment the child is enrolled \u2014 PPP-CH-0001 is the first child at Chuka. Write it on the paper form; the ward types it back for the later modules." },
          { "id": "hospital_number", "label": "Hospital number", "type": "text", "required": true, "identifier": true,
            "help": "The child's number at the enrolling hospital, exactly as written on the chart. It is declared here and nowhere else — it is what lets a query be traced back to a patient record, which is also why it never travels into the assessment modules or the analysis extract." },
          { "id": "date_of_birth", "label": "Date of birth", "type": "date_parts", "required": true,
            "identifier": true,
            "echo": "computed_age_label",
            "help": "Day / month / year pickers — never a typed date string. The computed age and the instrument it selects are echoed back immediately so a decade slip is caught at the bedside.",
            "hardBlock": ["future_date", "age_over_max"] },
          { "id": "computed_age_label", "label": "Age and instrument", "type": "computed", "derive": "age_label_with_instrument", "readOnly": true },
          { "id": "enrolled_at", "label": "Enrolment date and time", "type": "datetime", "required": true, "default": "now" }
        ]},
        { "id": "eligibility", "title": "Eligibility", "items": [
          { "id": "elig_elective",   "label": "Elective procedure on this camp list", "type": "boolean", "required": true },
          { "id": "elig_age",        "label": "Age within protocol range",            "type": "computed", "derive": "age_in_range", "readOnly": true },
          { "id": "elig_consent",    "label": "Legally authorised caregiver available to consent", "type": "boolean", "required": true },
          { "id": "eligible",        "label": "Eligible",                              "type": "computed", "derive": "eligibility_all", "readOnly": true },
          { "id": "screen_fail_reason", "label": "Reason not enrolled", "type": "select",
            "showIf": { "field": "eligible", "op": "eq", "value": false }, "required": true,
            "options": ["Emergency procedure", "Age outside range", "No caregiver available", "Caregiver declined", "Child declined assent", "Procedure cancelled", "Other"] }
        ]},
        { "id": "consent", "title": "Consent and assent", "items": [
          { "id": "consent_obtained", "label": "Written caregiver consent obtained", "type": "boolean", "required": true,
            "showIf": { "field": "eligible", "op": "eq", "value": true } },
          { "id": "consent_form_version", "label": "Consent form version", "type": "text", "required": true, "showIf": { "field": "consent_obtained", "op": "eq", "value": true } },
          { "id": "consent_language", "label": "Language of consent", "type": "select", "required": true, "showIf": { "field": "consent_obtained", "op": "eq", "value": true },
            "options": ["English", "Kiswahili", "French", "Other"] },
          { "id": "consent_at", "label": "Consent timestamp", "type": "datetime", "required": true, "showIf": { "field": "consent_obtained", "op": "eq", "value": true } },
          { "id": "assent_required", "label": "Assent required (age >= 7 y)", "type": "computed", "derive": "assent_required", "readOnly": true },
          { "id": "assent_obtained", "label": "Age-appropriate assent obtained", "type": "select", "required": true,
            "showIf": { "field": "assent_required", "op": "eq", "value": true },
            "options": ["Yes", "No — child declined", "No — child unable"] },
          { "id": "caregiver_relationship", "label": "Consenting caregiver relationship", "type": "select", "required": true,
            "options": ["Mother", "Father", "Grandparent", "Legal guardian", "Other relative"] }
        ]}
      ]
    },

    {
      "id": "02_preop",
      "title": "Preoperative baseline",
      "cardinality": "once",
      "sheet": "02_preop",
      "sections": [
        { "id": "demographics", "title": "Demographics and anthropometry", "items": [
          { "id": "age_days",   "label": "Age (days)",   "type": "computed", "derive": "age_days", "readOnly": true },
          { "id": "age_months", "label": "Age (months)", "type": "computed", "derive": "age_months", "readOnly": true },
          { "id": "age_confirmed", "label": "Rater confirms the displayed age is correct", "type": "boolean", "required": true,
            "help": "Age is derived from the date of birth recorded at enrolment. It is confirmed here, never re-entered." },
          { "id": "sex", "label": "Sex", "type": "select", "required": true, "options": ["Male", "Female", "Not recorded"] },
          { "id": "weight_kg", "label": "Weight", "type": "decimal", "required": true, "unit": "kg", "min": 0.5, "max": 120, "step": 0.1,
            "warnIf": "weight_implausible_for_age", "help": "Drives every weight-adjusted dose check in the study. Weigh, do not estimate." },
          { "id": "height_cm", "label": "Height / length", "type": "decimal", "required": true, "unit": "cm", "min": 30, "max": 200, "step": 0.5,
            "warnIf": "height_implausible_for_age" },
          { "id": "bmi", "label": "BMI", "type": "computed", "derive": "bmi", "unit": "kg/m2", "readOnly": true }
        ]},
        { "id": "clinical", "title": "Clinical status", "items": [
          { "id": "asa", "label": "ASA physical status", "type": "select", "required": true, "options": ["I", "II", "III"] },
          { "id": "diagnosis_icd11", "label": "Surgical diagnosis (ICD-11 code)", "type": "text", "required": true },
          { "id": "diagnosis_detail", "label": "Diagnosis detail", "type": "textarea", "required": false, "freeText": true,
            "help": "No names, no hospital numbers, no bed numbers." },
          { "id": "procedure_category", "label": "Planned procedure", "type": "select", "required": true,
            "options": ["Inguinal hernia repair", "Umbilical hernia repair", "Hydrocelectomy", "Orchidopexy", "Circumcision", "Cleft lip repair", "Cleft palate repair", "Limb / orthopaedic", "Excision of superficial mass", "Tonsillectomy / adenoidectomy", "Other"] },
          { "id": "laterality", "label": "Laterality", "type": "select", "required": true, "options": ["Left", "Right", "Bilateral", "Midline / not applicable"] },
          { "id": "chronic_pain_history", "label": "History of chronic pain", "type": "boolean", "required": true },
          { "id": "prior_surgery", "label": "Previous surgery", "type": "boolean", "required": true },
          { "id": "current_analgesics", "label": "Taking analgesics on admission", "type": "boolean", "required": true },
          { "id": "cognitive_impairment", "label": "Cognitive or developmental impairment", "type": "boolean", "required": true,
            "help": "If yes, all pain assessments route to revised FLACC regardless of age." },
          { "id": "rflacc_behaviours", "label": "Individualised behaviours (from caregiver)", "type": "textarea",
            "showIf": { "field": "cognitive_impairment", "op": "eq", "value": true }, "required": true, "freeText": false,
            "help": "How this child usually shows pain. Required for revised FLACC." }
        ]},
        { "id": "baseline_affect", "title": "Baseline pain and anxiety", "items": [
          { "id": "baseline_pain", "label": "Baseline pain at rest", "type": "pain_auto", "required": true },
          { "id": "mypas_sf", "label": "m-YPAS Short Form", "type": "mypas_sf", "required": true },
          { "id": "mypas_sf_score", "label": "m-YPAS-SF score", "type": "computed", "derive": "mypas_sf_score", "readOnly": true },
          { "id": "caregiver_anxiety_vas", "label": "Caregiver anxiety (visual analogue)", "type": "slider", "required": true, "min": 0, "max": 100, "step": 1,
            "anchors": { "low": "not at all anxious", "high": "extremely anxious" } },
          { "id": "caregiver_language", "label": "Caregiver preferred language", "type": "select", "required": true, "options": ["English", "Kiswahili", "French", "Other"] }
        ]}
      ]
    },

    {
      "id": "03_intraop",
      "title": "Intraoperative record",
      "cardinality": "once",
      "sheet": "03_intraop",
      "sections": [
        { "id": "timings", "title": "Timings", "items": [
          { "id": "anaesthesia_start", "label": "Anaesthesia start", "type": "datetime", "required": true },
          { "id": "incision",          "label": "Incision",          "type": "datetime", "required": true },
          { "id": "closure",           "label": "Closure",           "type": "datetime", "required": true },
          { "id": "anaesthesia_end",   "label": "Anaesthesia end",   "type": "datetime", "required": true,
            "help": "The anchor for every scheduled assessment. Record it accurately." },
          { "id": "surgical_duration_min",   "label": "Surgical duration",   "type": "computed", "derive": "surgical_duration_min", "unit": "min", "readOnly": true },
          { "id": "anaesthesia_duration_min","label": "Anaesthesia duration","type": "computed", "derive": "anaesthesia_duration_min", "unit": "min", "readOnly": true }
        ]},
        { "id": "surgery", "title": "Surgical data", "items": [
          { "id": "procedure_performed", "label": "Procedure performed", "type": "select", "required": true, "sameOptionsAs": "procedure_category" },
          { "id": "procedure_name", "label": "Specific operation", "type": "text", "required": true, "freeText": true,
            "showIf": { "field": "procedure_performed", "op": "present" },
            "help": "The operation as written on the operation note. The category is what the analysis groups on; this is what a surgeon recognises the case by. No patient names \u2014 the nightly scan reads this field." },
          { "id": "technique", "label": "Technique", "type": "select", "required": true, "options": ["Open", "Minimally invasive"] },
          { "id": "incision_length_cm", "label": "Incision length", "type": "decimal", "required": true, "unit": "cm", "min": 0, "max": 60, "step": 0.5 },
          { "id": "surgeon_grade", "label": "Primary operator", "type": "select", "required": true, "options": ["Consultant", "Fellow", "Registrar", "Medical officer"] }
        ]},
        { "id": "anaesthesia", "title": "Anaesthesia delivery", "items": [
          { "id": "induction_route", "label": "Induction", "type": "select", "required": true, "options": ["Inhalational", "Intravenous", "Combined"] },
          { "id": "airway", "label": "Airway", "type": "select", "required": true, "options": ["Facemask", "Supraglottic airway", "Tracheal tube", "Spontaneous / none"] },
          { "id": "maintenance", "label": "Maintenance", "type": "select", "required": true, "options": ["Sevoflurane", "Isoflurane", "TIVA (propofol)", "Combined", "Sedation only"] },
          { "id": "sevo_mac_hours", "label": "Sevoflurane exposure", "type": "decimal", "unit": "MAC-hours", "min": 0, "max": 20, "step": 0.1,
            "showIf": { "field": "maintenance", "op": "in", "value": ["Sevoflurane", "Combined"] }, "required": true },
          { "id": "propofol_total_mg", "label": "Total propofol", "type": "decimal", "unit": "mg", "min": 0, "max": 2000, "step": 1,
            "showIf": { "field": "maintenance", "op": "in", "value": ["TIVA (propofol)", "Combined"] }, "required": true },
          { "id": "intraop_opioids", "label": "Intraoperative opioids", "type": "drug_table", "required": true,
            "drugSet": "fentanylEquivalents", "allowNone": true,
            "columns": ["drug", "total_dose", "unit"] },
          { "id": "fent_eq_mcg_per_kg", "label": "Fentanyl equivalents", "type": "computed", "derive": "fent_eq_mcg_per_kg", "unit": "mcg/kg", "readOnly": true }
        ]},
        { "id": "block", "title": "Regional blockade", "items": [
          { "id": "block_performed", "label": "Regional block performed", "type": "boolean", "required": true },
          { "id": "block_technique", "label": "Technique", "type": "select", "required": true,
            "showIf": { "field": "block_performed", "op": "eq", "value": true },
            "options": ["Caudal epidural", "Lumbar epidural", "Spinal", "Transversus abdominis plane", "Ilioinguinal / iliohypogastric", "Rectus sheath", "Erector spinae plane", "Penile", "Brachial plexus", "Femoral", "Adductor canal", "Popliteal sciatic", "Local infiltration only", "Other"] },
          { "id": "block_guidance", "label": "Guidance", "type": "select", "required": true,
            "showIf": { "field": "block_performed", "op": "eq", "value": true },
            "options": ["Ultrasound", "Anatomical landmark", "Nerve stimulator", "Ultrasound + stimulator"] },
          { "id": "block_timing", "label": "Timing", "type": "select", "required": true,
            "showIf": { "field": "block_performed", "op": "eq", "value": true }, "options": ["Pre-incision", "Post-incision"] },
          { "id": "block_at", "label": "Block performed at", "type": "datetime", "required": true,
            "showIf": { "field": "block_performed", "op": "eq", "value": true },
            "help": "Anchors block duration and the Barry rebound window." },
          { "id": "la_agent", "label": "Local anaesthetic", "type": "select", "required": true,
            "showIf": { "field": "block_performed", "op": "eq", "value": true },
            "optionsFromParams": "localAnaesthetic.agents" },
          { "id": "la_concentration_pct", "label": "Concentration", "type": "decimal", "required": true, "unit": "%", "min": 0.05, "max": 2, "step": 0.05,
            "showIf": { "field": "block_performed", "op": "eq", "value": true } },
          { "id": "la_volume_ml", "label": "Volume injected", "type": "decimal", "required": true, "unit": "mL", "min": 0.1, "max": 60, "step": 0.1,
            "showIf": { "field": "block_performed", "op": "eq", "value": true } },
          { "id": "la_with_epinephrine", "label": "With epinephrine", "type": "boolean", "required": true,
            "showIf": { "field": "block_performed", "op": "eq", "value": true } },
          { "id": "la_mg_per_kg", "label": "Weight-adjusted dose", "type": "computed", "derive": "la_mg_per_kg", "unit": "mg/kg", "readOnly": true,
            "liveGuard": true, "hardBlock": ["la_over_max"],
            "help": "Shown live as volume is typed. Amber at 80% of maximum, hard block above 100%." },
          { "id": "la_pct_of_max", "label": "Percent of maximum", "type": "computed", "derive": "la_pct_of_max", "unit": "%", "readOnly": true },
          { "id": "adjuvants", "label": "Perineural adjuvants", "type": "drug_table", "allowNone": true,
            "showIf": { "field": "block_performed", "op": "eq", "value": true },
            "drugOptions": ["Dexamethasone", "Dexmedetomidine", "Clonidine", "Epinephrine"],
            "columns": ["drug", "dose", "unit"] },
          { "id": "block_success", "label": "No haemodynamic response to incision", "type": "select",
            "showIf": { "field": "block_performed", "op": "eq", "value": true }, "required": true,
            "options": ["Yes — block effective", "No — response to incision", "Not assessable"] }
        ]},
        { "id": "multimodal", "title": "Systemic multimodal analgesia", "items": [
          { "id": "paracetamol",   "label": "IV paracetamol",   "type": "dose_block", "unit": "mg/kg", "required": true },
          { "id": "nsaid",         "label": "IV NSAID",         "type": "dose_block", "unit": "mg/kg", "required": true, "drugOptions": ["Ketorolac", "Ibuprofen", "Diclofenac"] },
          { "id": "dexamethasone", "label": "IV dexamethasone",  "type": "dose_block", "unit": "mg/kg", "required": true },
          { "id": "ketamine",      "label": "IV ketamine",       "type": "dose_block", "unit": "mg/kg", "required": true },
          { "id": "lidocaine_iv",  "label": "IV lidocaine",      "type": "dose_block", "unit": "mg/kg", "required": true },
          { "id": "magnesium",     "label": "IV magnesium",      "type": "dose_block", "unit": "mg/kg", "required": true },
          { "id": "antiemetic",    "label": "Antiemetic",        "type": "dose_block", "unit": "mg/kg", "required": true, "drugOptions": ["Ondansetron", "Dexamethasone", "Both"] }
        ]},
        { "id": "intraop_events", "title": "Events", "items": [
          { "id": "intraop_complication", "label": "Intraoperative complication", "type": "boolean", "required": true },
          { "id": "intraop_complication_type", "label": "Complication", "type": "multiselect",
            "showIf": { "field": "intraop_complication", "op": "eq", "value": true }, "required": true,
            "options": ["Laryngospasm", "Bronchospasm", "Desaturation", "Bradycardia", "Hypotension", "Significant bleeding", "Failed block", "Dural puncture", "Other"] }
        ]}
      ]
    },

    {
      "id": "04_pacu_t0",
      "title": "PACU arrival — T0 adjudication",
      "cardinality": "once",
      "sheet": "04_pacu_t0",
      "note": "FLACC and PAED are both mandatory here, at every age. This is the only form that collects two instruments.",
      "sections": [
        { "id": "arrival", "title": "Arrival", "items": [
          { "id": "pacu_arrival_at", "label": "PACU arrival", "type": "datetime", "required": true, "default": "now" },
