          { "id": "flacc_total", "label": "FLACC total", "type": "computed", "derive": "flacc_total", "readOnly": true },
          { "id": "paed", "label": "PAED", "type": "paed", "required": true },
          { "id": "paed_total", "label": "PAED total", "type": "computed", "derive": "paed_total", "readOnly": true }
        ]},
        { "id": "gates", "title": "Behavioural gates", "items": [
          { "id": "gate_eye_contact", "label": "Makes eye contact", "type": "boolean", "required": true },
          { "id": "gate_purposeful",  "label": "Movement is purposeful", "type": "boolean", "required": true },
          { "id": "gate_aware",       "label": "Aware of surroundings", "type": "boolean", "required": true },
          { "id": "gate_consolable",  "label": "Consolable", "type": "boolean", "required": true }
        ]},
        { "id": "adjudication", "title": "Adjudication", "items": [
          { "id": "proposed_class", "label": "Proposed classification", "type": "computed", "derive": "pacu_classification", "readOnly": true,
            "help": "Advisory. The algorithm shows its reasoning; the nurse decides." },
          { "id": "proposed_rationale", "label": "Why", "type": "computed", "derive": "pacu_classification_rationale", "readOnly": true },
          { "id": "adjudicated_class", "label": "Nurse adjudication", "type": "select", "required": true,
            "options": ["Nociception", "Emergence delirium", "Both", "Indeterminate — reassess"] },
          { "id": "override_reason", "label": "Reason for differing from the proposal", "type": "select",
            "showIf": { "field": "adjudicated_class", "op": "differs_from", "value": "proposed_class" }, "required": true,
            "options": ["Behaviour changed since scoring", "Score does not reflect the child", "Known baseline behaviour", "Caregiver report", "Other"] },
          { "id": "intervention", "label": "Immediate intervention", "type": "multiselect", "required": true,
            "options": ["None", "Environmental calming", "Caregiver presence", "Non-opioid analgesia", "Opioid analgesia", "Low-dose sedative", "Other"] }
        ]},
        { "id": "discharge", "title": "PACU course", "items": [
          { "id": "rr", "label": "Respiratory rate", "type": "integer", "unit": "/min", "min": 4, "max": 80, "required": true },
          { "id": "spo2", "label": "SpO2", "type": "integer", "unit": "%", "min": 50, "max": 100, "required": true },
          { "id": "hr", "label": "Heart rate", "type": "integer", "unit": "/min", "min": 30, "max": 220, "required": true },
          { "id": "aldrete", "label": "Modified Aldrete score", "type": "integer", "min": 0, "max": 10, "required": true },
          { "id": "pacu_discharge_at", "label": "PACU discharge", "type": "datetime", "required": true,
            "warnIf": "aldrete_below_discharge_threshold" }
        ]}
      ]
    },

    {
      "id": "05_pain_obs",
      "title": "Serial pain assessment",
      "cardinality": "repeating",
      "sheet": "05_pain_obs",
      "note": "One row per child per timepoint. Long format. Designed for under 45 seconds at the bedside.",
      "naturalKey": ["study_number", "timepoint"],
      "sections": [
        { "id": "context", "title": "Context", "items": [
          { "id": "timepoint", "label": "Timepoint", "type": "select", "required": true, "optionsFromParams": "assessmentSchedule.timepoints", "includeUnscheduled": true },
          { "id": "assessed_at", "label": "Assessed at", "type": "datetime", "required": true, "default": "now" },
          { "id": "on_time", "label": "Within window", "type": "computed", "derive": "on_time_flag", "readOnly": true },
          { "id": "location", "label": "Location", "type": "select", "required": true, "options": ["PACU", "Ward", "Day-case bay", "Discharged — telephone follow-up"] },
          { "id": "entry_mode", "label": "How was this recorded", "type": "select", "required": true,
            "optionsFromParams": "dataCapture.entryModes", "default": "At the bedside",
            "warnIf": "entry_lag_disagrees",
            "help": "Answer honestly. Entering from notes or recall is expected and is not a protocol deviation — but it is weaker evidence, and the analysis needs to know which is which." },
          { "id": "entry_lag_h", "label": "Entered after", "type": "computed", "derive": "entry_lag_h", "unit": "h", "readOnly": true },
          { "id": "asleep", "label": "Child asleep", "type": "boolean", "required": true },
          { "id": "not_assessed_reason", "label": "Reason not assessed", "type": "select",
            "showIf": { "field": "asleep", "op": "eq", "value": true }, "required": true,
            "options": ["Asleep — not woken", "Child refused", "Caregiver declined", "Clinically unstable", "Off ward for procedure", "Not located"] }
        ]},
        { "id": "pain", "title": "Pain", "items": [
          { "id": "pain_rest", "label": "Pain at rest", "type": "pain_auto", "required": true,
            "showIf": { "field": "asleep", "op": "ne", "value": true },
            "warnIf": "pain_jump_from_previous" },
          { "id": "dynamic_maneuver", "label": "Evoked manoeuvre", "type": "select", "required": true,
            "showIf": { "field": "asleep", "op": "ne", "value": true },
            "defaultFrom": "procedure_category",
            "options": ["Cough", "Deep inspiration", "Assisted limb flexion", "Gentle palpation of surgical site", "Sitting up", "Not performed"] },
          { "id": "pain_dynamic", "label": "Pain on movement", "type": "pain_auto", "required": true,
            "showIf": { "field": "asleep", "op": "ne", "value": true },
            "warnIf": "dynamic_below_rest" }
        ]},
        { "id": "safety", "title": "Sedation, vitals and block", "items": [
          { "id": "umss", "label": "Sedation (UMSS)", "type": "umss", "required": true },
          { "id": "nausea", "label": "Nausea / vomiting", "type": "select", "required": true, "options": ["None", "Nausea only", "Vomited"] },
          { "id": "emesis_count", "label": "Emetic episodes since last assessment", "type": "integer", "min": 0, "max": 20,
            "showIf": { "field": "nausea", "op": "eq", "value": "Vomited" }, "required": true },
          { "id": "rr", "label": "Respiratory rate", "type": "integer", "unit": "/min", "min": 4, "max": 80, "required": true, "warnIf": "rr_below_age_threshold" },
          { "id": "spo2", "label": "SpO2", "type": "integer", "unit": "%", "min": 50, "max": 100, "required": true, "warnIf": "spo2_below_threshold" },
          { "id": "hr", "label": "Heart rate", "type": "integer", "unit": "/min", "min": 30, "max": 220, "required": true },
          { "id": "sensory_block_present", "label": "Sensory block still present", "type": "select", "required": true,
            "options": ["Yes", "No", "Unknown", "No block performed"],
            "help": "The first 'No' opens the block resolution form." },
          { "id": "rescue_given", "label": "Rescue analgesia given at this assessment", "type": "boolean", "required": true,
            "help": "Opens the analgesia log so the dose is recorded, not remembered." }
        ]}
      ]
    },

    {
      "id": "06_block_resolution",
      "title": "Block resolution and rebound",
      "cardinality": "once",
      "sheet": "06_block_resolution",
      "note": "Triggered when 05 first records sensory block absent; also openable ad hoc overnight.",
      "sections": [
        { "id": "regression", "title": "Regression", "items": [
          { "id": "sensory_return_at", "label": "Sensory return", "type": "datetime", "required": true },
          { "id": "ascertainment", "label": "How ascertained", "type": "select", "required": true,
            "options": ["Child reported sensation", "Cold / touch testing", "Return of motor function", "Onset of pain", "Caregiver report"] },
          { "id": "motor_return_at", "label": "Motor return", "type": "datetime", "required": false },
          { "id": "block_duration_h", "label": "Block duration", "type": "computed", "derive": "block_duration_h", "unit": "h", "readOnly": true },
          { "id": "regression_clock_time", "label": "Clock time of regression", "type": "computed", "derive": "regression_clock_time", "readOnly": true,
            "help": "Captures overnight regression, the highest-risk pattern." }
        ]},
        { "id": "rebound", "title": "Rebound", "items": [
          { "id": "pain_before_regression", "label": "Pain immediately before regression", "type": "pain_auto", "required": true },
          { "id": "pain_plus_1h", "label": "Pain at +1 h", "type": "pain_auto", "required": true },
          { "id": "pain_plus_2h", "label": "Pain at +2 h", "type": "pain_auto", "required": true },
          { "id": "rescue_requested", "label": "Rescue analgesia requested", "type": "boolean", "required": true },
          { "id": "rebound_protocol", "label": "Rebound (protocol definition)", "type": "computed", "derive": "rebound_protocol", "readOnly": true },
          { "id": "rebound_barry", "label": "Rebound (Barry 2021 definition)", "type": "computed", "derive": "rebound_barry", "readOnly": true },
          { "id": "rebound_confirmed", "label": "Nurse confirms rebound occurred", "type": "select", "required": true,
            "options": ["Yes", "No", "Uncertain"] }
        ]}
      ]
    },

    {
      "id": "07_analgesia_log",
      "title": "Analgesia administration log",
      "cardinality": "repeating",
      "sheet": "07_analgesia_log",
      "note": "One row per dose. Scheduled and rescue are separated so breakthrough pain can be isolated from baseline control.",
      "sections": [
        { "id": "dose", "title": "Dose", "items": [
          { "id": "given_at", "label": "Given at", "type": "datetime", "required": true, "default": "now" },
          { "id": "drug", "label": "Drug", "type": "select", "required": true,
            "options": ["Paracetamol", "Ibuprofen", "Diclofenac", "Ketorolac", "Morphine", "Fentanyl", "Oxycodone", "Hydromorphone", "Tramadol", "Codeine", "Ketamine", "Other"],
            "warnIf": "restricted_for_age" },
          { "id": "dose_amount", "label": "Dose", "type": "decimal", "required": true, "min": 0, "max": 5000, "step": 0.1,
            "help": "A wide bound only, because units vary from mcg to mg. The real guard is the weight-adjusted dose derived below." },
          { "id": "dose_unit", "label": "Unit", "type": "select", "required": true, "options": ["mg", "mcg", "mL"] },
          { "id": "route", "label": "Route", "type": "select", "required": true, "options": ["IV", "Oral", "Rectal", "IM", "Subcutaneous"] },
          { "id": "indication", "label": "Indication", "type": "select", "required": true,
            "options": ["Scheduled / around the clock", "PRN rescue", "Pre-emptive"],
            "help": "The scheduled versus rescue split is the study's breakthrough-pain signal. Do not default it." },
          { "id": "dose_mg_per_kg", "label": "Weight-adjusted dose", "type": "computed", "derive": "dose_mg_per_kg", "unit": "mg/kg", "readOnly": true },
          { "id": "mme", "label": "Oral morphine equivalents", "type": "computed", "derive": "dose_mme", "unit": "mg OME", "readOnly": true }
        ]},
        { "id": "effect", "title": "Effect", "items": [
          { "id": "pain_before", "label": "Pain immediately before", "type": "pain_auto", "required": true },
          { "id": "pain_after", "label": "Pain at 30-60 min after", "type": "pain_auto", "required": false },
          { "id": "prescriber", "label": "Ordered by", "type": "select", "required": true, "options": ["Anaesthetist", "Surgeon", "Medical officer", "Standing order"] }
        ]}
      ]
    },

    {
      "id": "08_adverse_events",
      "title": "Adverse events",
      "cardinality": "repeating",
      "sheet": "08_adverse_events",
      "sections": [
        { "id": "event", "title": "Event", "items": [
          { "id": "onset_at", "label": "Onset", "type": "datetime", "required": true },
          { "id": "event_type", "label": "Event", "type": "select", "required": true,
            "options": ["Postoperative nausea and vomiting", "Pruritus", "Urinary retention", "Oversedation (UMSS >= 3)", "Respiratory depression", "Local anaesthetic systemic toxicity", "Block-related complication", "Surgical site complication", "Unplanned reoperation", "Unplanned readmission", "Other"] },
          { "id": "severity", "label": "Severity grade", "type": "select", "required": true,
            "options": ["1 — mild", "2 — moderate", "3 — severe", "4 — life-threatening"],
            "escalateIf": ["3 — severe", "4 — life-threatening"] },
          { "id": "action", "label": "Action taken", "type": "multiselect", "required": true,
            "options": ["None", "Observation", "Drug treatment", "Naloxone", "Oxygen", "Airway support", "Fluid bolus", "Return to theatre", "Escalation to PI"] },
          { "id": "outcome", "label": "Outcome", "type": "select", "required": true,
            "options": ["Resolved", "Resolving", "Ongoing at 48 h", "Sequelae", "Fatal"] },
          { "id": "related_to_analgesia", "label": "Judged related to analgesic management", "type": "select", "required": true,
            "options": ["Unrelated", "Possibly", "Probably", "Definitely"] },
          { "id": "ae_narrative", "label": "Narrative", "type": "textarea", "required": true, "freeText": true,
            "help": "No names, no hospital numbers, no bed numbers." }
        ]}
      ]
    },

    {
      "id": "09_exit",
      "title": "48-hour exit and recovery milestones",
      "cardinality": "once",
      "sheet": "09_exit",
      "sections": [
        { "id": "milestones", "title": "Recovery milestones", "items": [
          { "id": "first_oral_liquid_at", "label": "First oral liquid", "type": "datetime", "required": false },
          { "id": "first_solid_at", "label": "First solid food", "type": "datetime", "required": false },
          { "id": "first_void_at", "label": "First void", "type": "datetime", "required": false },
          { "id": "ambulation_at", "label": "Unassisted ambulation", "type": "datetime", "required": false,
            "help": "Age-adapted: for pre-ambulatory infants record return to normal spontaneous movement." },
          { "id": "ambulation_na", "label": "Not applicable — pre-ambulatory", "type": "boolean", "required": true },
          { "id": "awakenings_night1", "label": "Nocturnal awakenings, night 1", "type": "integer", "min": 0, "max": 30, "required": true },
          { "id": "awakenings_night2", "label": "Nocturnal awakenings, night 2", "type": "integer", "min": 0, "max": 30, "required": true }
        ]},
        { "id": "satisfaction", "title": "Caregiver and child report", "items": [
          { "id": "caregiver_satisfaction", "label": "Caregiver satisfaction with pain management", "type": "slider", "min": 0, "max": 10, "step": 1, "required": true,
            "anchors": { "low": "not at all satisfied", "high": "completely satisfied" } },
          { "id": "analgesia_adequate", "label": "Caregiver judged analgesia adequate", "type": "select", "required": true,
            "options": ["Yes, throughout", "Mostly", "Sometimes inadequate", "Frequently inadequate"] },
          { "id": "child_global_impression", "label": "Child global impression of recovery", "type": "select", "required": false,
            "showIf": { "field": "age_years", "op": "gte", "value": 6 },
            "options": ["Much better", "Better", "About the same", "Worse"] }
        ]},
        { "id": "closeout", "title": "Close-out", "items": [
          { "id": "discharge_at", "label": "Discharge", "type": "datetime", "required": true },
          { "id": "discharge_analgesia", "label": "Discharge analgesia supplied", "type": "multiselect", "required": true,
            "options": ["None", "Paracetamol", "Ibuprofen", "Other NSAID", "Weak opioid", "Strong opioid"] },
          { "id": "deviation", "label": "Protocol deviation occurred", "type": "boolean", "required": true },
          { "id": "deviation_detail", "label": "Deviation detail", "type": "textarea", "freeText": true,
            "showIf": { "field": "deviation", "op": "eq", "value": true }, "required": true },
          { "id": "completion_status", "label": "Completion status", "type": "select", "required": true,
            "options": ["Completed 48 h", "Early discharge — follow-up by telephone", "Early discharge — no follow-up", "Lost to follow-up", "Withdrawn by caregiver", "Withdrawn by investigator"] },
          { "id": "withdrawal_reason", "label": "Reason", "type": "textarea",
            "showIf": { "field": "completion_status", "op": "in", "value": ["Withdrawn by caregiver", "Withdrawn by investigator"] }, "required": true }
        ]}
      ]
    },

    {
      "id": "10_calibration",
      "title": "Rater calibration",
      "cardinality": "repeating",
      "sheet": "10_calibration",
      "note": "Pre-camp and mid-camp. Raters below the kappa gate stay in training mode.",
      "sections": [
        { "id": "vignette", "title": "Vignette scoring", "items": [
          { "id": "round", "label": "Calibration round", "type": "select", "required": true, "options": ["Pre-camp", "Mid-camp drift check"] },
          { "id": "vignette_id", "label": "Vignette", "type": "text", "required": true },
          { "id": "instrument", "label": "Instrument", "type": "select", "required": true, "options": ["FLACC", "FPS-R", "PAED"] },
          { "id": "score", "label": "Score", "type": "integer", "required": true, "min": 0, "max": 20 },
          { "id": "scored_at", "label": "Scored at", "type": "datetime", "required": true, "default": "now" }
        ]}
      ]
    }
  ]
}
